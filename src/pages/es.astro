<script>
  document.querySelectorAll<HTMLButtonElement>('[data-service-open]').forEach((button) => {
    const dialog = document.querySelector<HTMLDialogElement>(\`[data-service-dialog="\${button.dataset.serviceOpen}"]\`);
    if (!dialog) return;
    button.addEventListener('click', () => dialog.showModal());
    dialog.querySelector<HTMLButtonElement>('[data-service-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
