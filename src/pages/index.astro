---
const services = [
  { number: '01', title: 'LegalTech & Innovation', text: 'Modernize legal operations with clear strategy, better systems and measurable adoption.' },
  { number: '02', title: 'Data & Intelligence', text: 'Turn fragmented information into decision-ready intelligence and operational advantage.' },
  { number: '03', title: 'AI Strategy & Automation', text: 'Identify the right AI opportunities and move from experimentation to impact.' },
];
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>GDA Consulting | Technology, Data & Innovation</title>
    <meta name="description" content="GDA Consulting helps ambitious organizations turn complexity into technology-led advantage." />
  </head>
  <body>
    <div class="orb orb-one"></div><div class="orb orb-two"></div>
    <header>
      <a class="brand" href="/" aria-label="GDA Consulting home"><span class="brand-mark">G</span><span>GDA<span class="muted"> Consulting</span></span></a>
      <a class="nav-link" href="mailto:info@gdaconsulting.com.ar">Let’s talk <span>↗</span></a>
    </header>
    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow"><span class="pulse"></span> Technology · Data · Innovation</p>
          <h1>Make complexity<br /><span>work for you.</span></h1>
          <p class="lead">GDA Consulting helps ambitious teams connect strategy, technology and intelligence to build what’s next.</p>
          <div class="actions"><a class="button" href="mailto:info@gdaconsulting.com.ar">Start a conversation <span>↗</span></a><a class="text-link" href="#services">Explore capabilities <span>↓</span></a></div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="grid-lines"></div><div class="ring ring-a"></div><div class="ring ring-b"></div><div class="core"><span>GDA</span><small>BUILD<br />FORWARD</small></div>
          <div class="tag tag-top">SYSTEMS <span>+</span> SIGNALS</div><div class="tag tag-bottom">GLOBAL REACH <span>↗</span></div>
        </div>
      </section>
      <section class="signal-row"><div><strong>01</strong><span>Strategic clarity</span></div><div><strong>02</strong><span>Technical depth</span></div><div><strong>03</strong><span>Global reach</span></div></section>
      <section class="services" id="services">
        <div class="section-heading"><div><p class="eyebrow">Capabilities</p><h2>From signal<br /><span>to momentum.</span></h2></div><p class="section-intro">We work at the intersection of business, systems and emerging technology — translating complexity into confident action.</p></div>
        <div class="service-grid">{services.map((service) => <article><div class="service-top"><span>{service.number}</span><span class="arrow">↗</span></div><h3>{service.title}</h3><p>{service.text}</p></article>)}</div>
      </section>
      <section class="contact-panel"><div><p class="eyebrow">Let’s build what’s next</p><h2>Ready when<br /><span>you are.</span></h2></div><div class="contact-details"><a href="mailto:info@gdaconsulting.com.ar">info@gdaconsulting.com.ar <span>↗</span></a><a href="tel:+17864809312">+1 (786) 480-9312</a><a href="tel:+5492616681106">+54 9 261 668 1106</a></div></section>
    </main>
    <footer><span>© {new Date().getFullYear()} GDA Consulting</span><span>Global reach · Built for what’s next</span></footer>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; } :global(html) { scroll-behavior:smooth; } :global(body) { margin:0; background:#080b16; color:#f7f8ff; font-family:Arial, Helvetica, sans-serif; overflow-x:hidden; } :global(body)::before { content:''; position:fixed; inset:0; pointer-events:none; opacity:.13; background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px); background-size:64px 64px; mask-image:linear-gradient(to bottom,black,transparent 80%); }
  header, main, footer { max-width:1240px; margin:auto; padding-left:32px; padding-right:32px; } header { display:flex; align-items:center; justify-content:space-between; padding-top:30px; padding-bottom:30px; position:relative; z-index:2; } .brand { display:flex; align-items:center; gap:11px; color:#fff; text-decoration:none; font-weight:700; letter-spacing:-.03em; font-size:1.08rem; } .brand-mark { display:grid; place-items:center; width:30px; height:30px; border:1px solid #8a7dff; border-radius:9px; color:#b9b2ff; font-size:.8rem; } .muted { color:#8890ac; font-weight:400; } .nav-link { color:#fff; text-decoration:none; font-size:.8rem; letter-spacing:.04em; } .nav-link span, .button span, .text-link span, .contact-details span { color:#8f83ff; margin-left:7px; }
  .orb { position:absolute; border-radius:50%; filter:blur(80px); pointer-events:none; } .orb-one { width:440px; height:440px; background:#312b9a; opacity:.36; top:30px; right:3%; } .orb-two { width:300px; height:300px; background:#009fbe; opacity:.17; top:500px; left:-130px; }
  .hero { min-height:590px; display:grid; grid-template-columns:1.05fr .95fr; align-items:center; gap:30px; padding-top:72px; padding-bottom:80px; position:relative; } .hero-copy { position:relative; z-index:1; } .eyebrow { color:#a9a6ff; text-transform:uppercase; letter-spacing:.2em; font-size:.68rem; font-weight:700; margin:0 0 25px; } .pulse { display:inline-block; width:7px; height:7px; margin-right:10px; border-radius:50%; background:#64e7dd; box-shadow:0 0 14px #64e7dd; } h1 { font-size:clamp(4rem,8vw,7.8rem); line-height:.88; letter-spacing:-.09em; margin:0 0 32px; max-width:760px; } h1 span, h2 span { color:#8f83ff; } .lead { color:#a8aec4; font-size:1.15rem; line-height:1.6; max-width:500px; margin:0 0 35px; } .actions { display:flex; align-items:center; gap:26px; flex-wrap:wrap; } .button { display:inline-flex; align-items:center; background:#f5f4ff; color:#0b0d18; padding:16px 21px; text-decoration:none; border-radius:7px; font-size:.8rem; font-weight:700; box-shadow:0 0 35px rgba(143,131,255,.18); } .text-link { color:#b5bad0; text-decoration:none; font-size:.8rem; }
  .hero-visual { min-height:420px; position:relative; display:grid; place-items:center; } .grid-lines { position:absolute; inset:10%; background:linear-gradient(90deg,transparent 49.7%,rgba(143,131,255,.22) 50%,transparent 50.3%),linear-gradient(transparent 49.7%,rgba(143,131,255,.22) 50%,transparent 50.3%); background-size:76px 76px; transform:rotate(-15deg); mask-image:radial-gradient(circle,black 20%,transparent 70%); } .ring { position:absolute; border:1px solid rgba(143,131,255,.5); border-radius:50%; transform:rotateX(63deg) rotateZ(-15deg); box-shadow:0 0 45px rgba(143,131,255,.18); } .ring-a { width:330px; height:330px; } .ring-b { width:235px; height:235px; border-color:rgba(100,231,221,.55); transform:rotateX(63deg) rotateZ(38deg); } .core { width:138px; height:138px; display:grid; place-items:center; align-content:center; gap:8px; border-radius:35px; background:linear-gradient(145deg,#8f83ff,#2c275f); box-shadow:0 0 80px rgba(143,131,255,.6), inset 0 1px 0 rgba(255,255,255,.55); transform:rotate(-8deg); } .core span { font-size:1.65rem; font-weight:800; letter-spacing:-.1em; } .core small { color:#d9d6ff; font-size:.48rem; letter-spacing:.22em; line-height:1.5; text-align:center; } .tag { position:absolute; color:#a8aec4; font-size:.58rem; letter-spacing:.18em; } .tag span { color:#64e7dd; } .tag-top { top:26px; right:3%; } .tag-bottom { bottom:40px; left:8%; }
  .signal-row { border-top:1px solid rgba(255,255,255,.13); border-bottom:1px solid rgba(255,255,255,.13); display:grid; grid-template-columns:repeat(3,1fr); padding:22px 0; } .signal-row div { display:flex; gap:18px; align-items:center; padding-left:20px; border-left:1px solid rgba(255,255,255,.13); } .signal-row div:first-child { border-left:0; padding-left:0; } .signal-row strong { color:#8f83ff; font-size:.72rem; } .signal-row span { color:#ccd0e2; font-size:.8rem; }
  .services { padding:130px 0 120px; } .section-heading { display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:end; margin-bottom:58px; } h2 { font-size:clamp(3rem,6vw,5.9rem); line-height:.9; letter-spacing:-.08em; margin:0; } .section-intro { color:#8e95ae; line-height:1.6; max-width:390px; margin:0 0 5px; } .service-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; } .service-grid article { min-height:280px; padding:22px; border:1px solid rgba(255,255,255,.12); border-radius:12px; background:linear-gradient(145deg,rgba(255,255,255,.065),rgba(255,255,255,.015)); transition:transform .25s,border-color .25s; } .service-grid article:hover { transform:translateY(-7px); border-color:rgba(143,131,255,.8); } .service-top { display:flex; justify-content:space-between; color:#8f83ff; font-size:.75rem; } .arrow { color:#64e7dd; } h3 { font-size:1.65rem; line-height:1.05; letter-spacing:-.05em; margin:72px 0 18px; max-width:240px; } .service-grid p { color:#8e95ae; line-height:1.55; font-size:.9rem; max-width:280px; }
  .contact-panel { border:1px solid rgba(143,131,255,.35); border-radius:14px; padding:54px; display:grid; grid-template-columns:1fr 1fr; gap:30px; background:radial-gradient(circle at 80% 20%,rgba(143,131,255,.18),transparent 45%),rgba(255,255,255,.035); } .contact-details { display:flex; flex-direction:column; justify-content:center; gap:15px; } .contact-details a { color:#dce0f0; text-decoration:none; font-size:.95rem; } footer { display:flex; justify-content:space-between; color:#737b99; font-size:.7rem; padding-top:25px; padding-bottom:30px; }
  @media (max-width:800px) { header,main,footer { padding-left:20px; padding-right:20px; } .hero { grid-template-columns:1fr; padding-top:55px; } .hero-visual { min-height:330px; margin-top:-25px; } .signal-row { grid-template-columns:1fr; gap:15px; } .signal-row div { border-left:0; padding-left:0; } .section-heading,.contact-panel { grid-template-columns:1fr; } .services { padding:90px 0; } .service-grid { grid-template-columns:1fr; } .service-grid article { min-height:230px; } h3 { margin-top:55px; } .contact-panel { padding:32px 24px; } footer { flex-direction:column; gap:10px; } }
</style>
