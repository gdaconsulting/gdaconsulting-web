---
const services = ['LegalTech & Innovation', 'Business Intelligence & Data', 'AI Strategy & Automation'];
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>GDA Consulting | Technology, Data & Innovation</title>
    <meta name="description" content="GDA Consulting helps organizations turn technology, data and innovation into measurable results." />
  </head>
  <body>
    <header><a class="brand" href="/">GDA<span>Consulting</span></a><a class="contact" href="mailto:hello@gdaconsulting.com.ar">Let’s talk →</a></header>
    <main>
      <section class="hero">
        <p class="eyebrow">Technology · Data · Innovation</p>
        <h1>Clarity for complex<br /><em>business challenges.</em></h1>
        <p class="lead">GDA Consulting partners with ambitious teams to design smarter operations, unlock data and build technology that moves the business forward.</p>
        <a class="button" href="mailto:hello@gdaconsulting.com.ar">Start a conversation</a>
      </section>
      <section class="services">
        <p class="eyebrow">What we do</p>
        <div class="grid">{services.map((service, index) => <article><span>0{index + 1}</span><h2>{service}</h2><p>Practical expertise, thoughtful strategy and outcomes you can measure.</p></article>)}</div>
      </section>
    </main>
    <footer><span>© {new Date().getFullYear()} GDA Consulting</span><span>Buenos Aires · Global perspective</span></footer>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; } :global(body) { margin: 0; background: #f4f1eb; color: #15251f; font-family: Arial, sans-serif; }
  header, footer { display:flex; justify-content:space-between; align-items:center; max-width:1180px; margin:auto; padding:32px 28px; }
  .brand { color:inherit; text-decoration:none; font-weight:700; letter-spacing:-.04em; font-size:1.35rem; } .brand span { font-weight:400; } .contact { color:inherit; text-decoration:none; font-size:.9rem; }
  main { max-width:1180px; margin:auto; padding:70px 28px 100px; } .hero { max-width:850px; padding:60px 0 150px; } .eyebrow { color:#a35e3b; text-transform:uppercase; letter-spacing:.16em; font-size:.72rem; font-weight:700; }
  h1 { font-size:clamp(3.5rem, 8vw, 7.8rem); line-height:.92; letter-spacing:-.08em; margin:28px 0; } h1 em { color:#a35e3b; font-style:normal; } .lead { max-width:540px; font-size:1.18rem; line-height:1.6; color:#52605a; margin-bottom:36px; }
  .button { display:inline-block; background:#15251f; color:#fff; padding:16px 22px; text-decoration:none; border-radius:999px; font-size:.9rem; } .services { border-top:1px solid #c8c4bb; padding-top:28px; } .grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; margin-top:48px; } article { border-top:2px solid #15251f; padding-top:18px; } article span { color:#a35e3b; font-size:.75rem; } h2 { font-size:1.7rem; letter-spacing:-.04em; line-height:1.05; margin:42px 0 16px; } article p { color:#68736d; line-height:1.5; } footer { border-top:1px solid #c8c4bb; color:#68736d; font-size:.75rem; padding-top:22px; }
  @media (max-width:700px) { header, footer, main { padding-left:20px; padding-right:20px; } .hero { padding:40px 0 100px; } .grid { grid-template-columns:1fr; gap:36px; } h2 { margin-top:24px; } footer { align-items:flex-start; gap:12px; flex-direction:column; } }
</style>
