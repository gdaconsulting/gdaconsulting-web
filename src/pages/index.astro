---
const services = [
  { number: '01', title: 'Legal technology', text: 'Improve matter intake, workflows and legal systems so teams can spend less time on friction and more time on meaningful work.' },
  { number: '02', title: 'Data & BI', text: 'Connect operational data and turn it into clear reporting that helps leaders see performance, workload and what needs attention.' },
  { number: '03', title: 'AI & automation', text: 'Find practical, responsible ways to automate repetitive work and bring AI into existing processes with purpose.' },
];
const principles = [
  { number: '01', title: 'Understand', text: 'Start with the people, processes, information and systems behind the challenge.' },
  { number: '02', title: 'Design', text: 'Choose a focused path forward, with clear priorities, ownership and measures of success.' },
  { number: '03', title: 'Deliver', text: 'Put the right changes into practice and help teams adopt them in their day-to-day work.' },
];
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#071a35" />
    <title>GDA Consulting | Technology, Data & Innovation</title>
    <meta name="description" content="GDA Consulting connects strategy, technology and intelligence to help ambitious teams build what is next." />
  </head>
  <body>
    <div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
    <header>
      <a class="brand" href="/" aria-label="GDA Consulting home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 240 210" role="img">
            <defs>
              <linearGradient id="ribbon-top" x1="22" y1="105" x2="218" y2="12" gradientUnits="userSpaceOnUse"><stop stop-color="#8855ff" /><stop offset=".38" stop-color="#08caff" /><stop offset=".72" stop-color="#4d91ff" /><stop offset="1" stop-color="#a645f4" /></linearGradient>
              <linearGradient id="ribbon-bottom" x1="27" y1="128" x2="204" y2="170" gradientUnits="userSpaceOnUse"><stop stop-color="#6632e8" /><stop offset=".38" stop-color="#138dff" /><stop offset=".77" stop-color="#11c9ff" /><stop offset="1" stop-color="#4c6dff" /></linearGradient>
              <linearGradient id="ribbon-fold" x1="178" y1="75" x2="221" y2="145" gradientUnits="userSpaceOnUse"><stop stop-color="#f8fbff" /><stop offset=".42" stop-color="#9aa8c4" /><stop offset=".72" stop-color="#eef5ff" /><stop offset="1" stop-color="#586986" /></linearGradient>
            </defs>
            <path d="M23 101C25 62 89 25 191 5L221 19C143 43 94 70 55 113C42 127 39 137 48 146C28 135 19 119 23 101Z" fill="url(#ribbon-top)" />
            <path d="M47 121C78 161 132 166 188 109L214 119C180 182 111 205 64 170C40 152 29 135 47 121Z" fill="url(#ribbon-bottom)" />
            <path d="M106 105 177 66C194 66 210 74 219 89C187 81 161 91 131 106Z" fill="#08bff4" />
            <path d="M177 66C211 66 230 89 226 116C222 146 195 166 167 174C189 155 203 140 202 116C201 92 190 75 177 66Z" fill="url(#ribbon-fold)" />
          </svg>
        </span><span>GDA<span class="muted"> Consulting</span></span>
      </a>
      <nav aria-label="Primary"><a class="nav-link" href="#services">Services</a><a class="nav-link" href="#approach">How we work</a><a class="nav-link" href="#about">About GDA</a><a class="nav-link nav-cta" href="#contact">Book a call <span>↗</span></a></nav>
    </header>
    <main>
      <section class="hero-carousel" aria-label="GDA Consulting highlights" data-carousel>
        <div class="hero-slide slide-strategy is-active" role="group" aria-roledescription="slide" aria-label="1 of 3: Turn complexity into momentum" data-slide>
        <div class="hero">
        <div class="hero-copy">
          <p class="eyebrow"><span class="pulse"></span> Strategy · Systems · Intelligence</p>
          <h1>Turn complexity<br /><span>into momentum.</span></h1>
          <p class="lead">GDA Consulting helps ambitious teams connect business intent with technology that moves the work forward.</p>
          <div class="actions"><a class="button" href="#contact">Book a call <span>↗</span></a><a class="text-link" href="#services">Explore services <span>↓</span></a></div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="visual-glow"></div>
          <svg class="network-art" viewBox="0 0 620 560" role="img">
            <defs>
              <radialGradient id="planet-fill" cx="35%" cy="30%"><stop offset="0" stop-color="#45d9ff" stop-opacity=".9" /><stop offset=".42" stop-color="#2479dc" stop-opacity=".72" /><stop offset="1" stop-color="#071b3b" stop-opacity=".1" /></radialGradient>
              <linearGradient id="arc-blue" x1="0" y1="1" x2="1" y2="0"><stop stop-color="#2bbcff" stop-opacity=".05" /><stop offset=".5" stop-color="#76efff" /><stop offset="1" stop-color="#8294ff" stop-opacity=".18" /></linearGradient>
              <filter id="blue-glow"><feGaussianBlur stdDeviation="7" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
              <clipPath id="planet-clip"><circle cx="360" cy="294" r="162" /></clipPath>
            </defs>
            <g class="art-orbits">
              <ellipse class="orbit orbit-one" cx="360" cy="294" rx="222" ry="108" />
              <ellipse class="orbit orbit-two" cx="360" cy="294" rx="190" ry="244" transform="rotate(54 360 294)" />
              <ellipse class="orbit orbit-three" cx="360" cy="294" rx="164" ry="250" transform="rotate(-58 360 294)" />
            </g>
            <circle class="planet" cx="360" cy="294" r="162" fill="url(#planet-fill)" />
            <g class="network-lines" clip-path="url(#planet-clip)">
              <path d="M160 246C244 181 342 181 468 232 536 259 566 311 592 364" />
              <path d="M142 322C245 285 360 277 548 317" />
              <path d="M205 404C296 352 401 350 540 394" />
              <path d="M270 126C300 211 312 310 278 470" />
              <path d="M380 112C347 225 371 346 432 468" />
              <path d="M468 145C411 231 447 339 510 421" />
            </g>
            <g class="data-trails" fill="none" stroke-linecap="round">
              <path d="M75 394C180 390 202 286 302 246S470 164 568 80" stroke="url(#arc-blue)" />
              <path d="M140 96C245 145 280 205 394 215S514 285 568 454" stroke="url(#arc-blue)" />
            </g>
            <g class="nodes" filter="url(#blue-glow)">
              <circle cx="212" cy="242" r="5" /><circle cx="277" cy="362" r="6" /><circle cx="365" cy="181" r="5" /><circle cx="460" cy="281" r="7" /><circle cx="424" cy="407" r="5" /><circle cx="508" cy="176" r="4" />
            </g>
            <circle class="signal-node" cx="568" cy="80" r="7" filter="url(#blue-glow)" />
          </svg>
          <div class="visual-label label-top"><span class="label-dot"></span>GLOBAL / SIGNAL</div>
          <div class="visual-label label-bottom">SYSTEMS THAT MOVE <span>↗</span></div>
        </div>
        </div>
        </div>
        <div class="hero-slide slide-global" role="group" aria-roledescription="slide" aria-label="2 of 3: Insight without borders" aria-hidden="true" inert data-slide>
          <div class="slide-global-image" aria-hidden="true"></div>
          <div class="slide-global-shade" aria-hidden="true"></div>
          <div class="slide-copy">
          <p class="eyebrow">Connected thinking</p>
          <h2 id="global-heading">Insight without<br /><span>borders.</span></h2>
          <p>Wherever the challenge starts, we connect the signals, systems and people that can move it forward.</p>
          <a class="button" href="#contact">Book a call <span>↗</span></a>
          </div>
          <span class="slide-side-note">GLOBAL PERSPECTIVE / REAL-WORLD IMPACT</span>
        </div>
        <div class="hero-slide slide-impact" role="group" aria-roledescription="slide" aria-label="3 of 3: From signal to impact" aria-hidden="true" inert data-slide>
          <div class="slide-copy">
            <p class="eyebrow">The GDA approach</p>
            <h2>From signal<br /><span>to impact.</span></h2>
            <p>Strategy matters when it changes how work gets done. We connect ideas, technology and adoption into forward motion.</p>
            <a class="button" href="#approach">See our approach <span>↗</span></a>
          </div>
          <div class="impact-visual" aria-hidden="true">
            <div class="impact-halo"></div>
            <div class="impact-connector"></div>
            <div class="impact-card impact-card-one"><span>01 / DISCOVER</span><div class="signal-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><strong>Find the signal</strong></div>
            <div class="impact-card impact-card-two"><span>02 / DESIGN</span><div class="impact-map"><i></i><i></i><i></i><i></i><i></i></div><strong>Shape the system</strong></div>
            <div class="impact-card impact-card-three"><span>03 / DELIVER</span><div class="impact-line"><i></i><i></i><i></i><i></i></div><strong>Build momentum</strong></div>
          </div>
          <span class="slide-side-note">THINK CLEARLY / MOVE DECISIVELY</span>
        </div>
        <div class="carousel-controls" aria-label="Carousel controls">
          <div class="slide-tabs">
            <button class="slide-tab is-active" type="button" data-slide-to="0" aria-label="Show slide 1: Turn complexity into momentum" aria-pressed="true"><span>01</span> Strategy</button>
            <button class="slide-tab" type="button" data-slide-to="1" aria-label="Show slide 2: Insight without borders" aria-pressed="false"><span>02</span> Global</button>
            <button class="slide-tab" type="button" data-slide-to="2" aria-label="Show slide 3: From signal to impact" aria-pressed="false"><span>03</span> Impact</button>
          </div>
          <div class="slide-arrows"><button type="button" data-slide-pause aria-label="Pause automatic slideshow" aria-pressed="false"><svg class="playback-icon" viewBox="0 0 24 24" aria-hidden="true"><rect class="pause-shape" x="6" y="5" width="4" height="14" rx="1" /><rect class="pause-shape" x="14" y="5" width="4" height="14" rx="1" /><path class="play-shape" d="M7 4.5 19 12 7 19.5Z" /></svg></button><button type="button" data-slide-prev aria-label="Previous slide">←</button><button type="button" data-slide-next aria-label="Next slide">→</button></div>
        </div>
      </section>
      <section class="services" id="services">
        <div class="section-heading"><div><p class="eyebrow">Services</p><h2>Make work<br /><span>work better.</span></h2></div><p class="section-intro">GDA helps legal and professional services teams connect their processes, technology and information to make everyday work clearer and more effective.</p></div>
        <div class="service-grid">{services.map((service) => <article><div class="service-top"><span>{service.number}</span><span class="arrow">↗</span></div><h3>{service.title}</h3><p>{service.text}</p><a href="mailto:info@gdaconsulting.com.ar">Explore the conversation <span>↗</span></a></article>)}</div>
      </section>
      <section class="approach" id="approach">
        <div class="section-heading approach-heading"><div><p class="eyebrow">How we work</p><h2>From the real<br /><span>problem to progress.</span></h2></div><p class="section-intro">We work alongside your team, connecting strategic choices with practical delivery and the adoption needed to make change last.</p></div>
        <div class="principle-grid">{principles.map((principle) => <article><span class="principle-number">{principle.number}</span><h3>{principle.title}</h3><p>{principle.text}</p></article>)}</div>
      </section>
      <section class="about" id="about">
        <div class="about-copy"><p class="eyebrow">About GDA</p><h2>Global perspective.<br /><span>Practical progress.</span></h2><p>GDA Consulting works at the intersection of legal operations, technology and data. We help organizations move from fragmented processes and tools to connected, decision-ready ways of working.</p><p>Our focus is straightforward: understand the work, choose the right changes and help teams put them into practice.</p></div>
        <div class="about-focus" aria-label="GDA areas of focus"><span>Legal operations</span><span>Technology & systems</span><span>Data & AI</span><span>Adoption & delivery</span></div>
      </section>
      <section class="contact-panel" id="contact"><div><p class="eyebrow">Start a conversation</p><h2>Let’s find<br /><span>the next step.</span></h2></div><div class="contact-details"><p>Tell us what you’re working through. We’ll arrange a 30-minute introductory conversation.</p><a class="contact-booking" href="mailto:info@gdaconsulting.com.ar?subject=Introductory%20conversation">Email to arrange a call <span>↗</span></a><a class="contact-email" href="mailto:info@gdaconsulting.com.ar">info@gdaconsulting.com.ar <span>↗</span></a><a href="tel:+17864809312">+1 (786) 480-9312</a><a href="tel:+5492616681106">+54 9 261 668 1106</a></div></section>
    </main>
    <footer><span>© {new Date().getFullYear()} GDA Consulting</span><span>Global perspective · Built for what’s next</span></footer>
  </body>
</html>
<style>
  :global(*) { box-sizing:border-box; } :global(html) { scroll-behavior:smooth; } :global(body) { margin:0; background:linear-gradient(180deg,transparent 0,transparent 900px,#071a35 1500px),linear-gradient(90deg,#061a35 0%,#082246 52%,#0b376e 100%); color:#f4f9ff; font-family:Arial, Helvetica, sans-serif; overflow-x:hidden; } :global(body)::before { content:''; position:fixed; inset:0; pointer-events:none; opacity:.14; background-image:linear-gradient(rgba(142,219,255,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(142,219,255,.12) 1px,transparent 1px); background-size:72px 72px; mask-image:linear-gradient(to bottom,black,transparent 75%); }
  header,main,footer { max-width:1240px; margin:auto; padding-left:32px; padding-right:32px; } header { display:flex; align-items:center; justify-content:space-between; gap:28px; padding-top:28px; padding-bottom:25px; position:relative; z-index:5; } .brand { display:flex; align-items:center; gap:11px; color:#f7fbff; text-decoration:none; font-weight:700; letter-spacing:-.03em; font-size:1.08rem; } .brand-mark { display:block; width:46px; height:42px; flex:0 0 46px; } .brand-mark svg { display:block; width:100%; height:100%; filter:drop-shadow(0 0 12px rgba(43,188,255,.36)); } .muted { color:#91aac8; font-weight:400; } nav { display:flex; align-items:center; gap:27px; } .nav-link { color:#b9cde3; text-decoration:none; font-size:.74rem; letter-spacing:.04em; } .nav-link:hover { color:#fff; } .nav-cta { color:#f7fbff; } .nav-link span,.button span,.text-link span,.contact-details span,.service-grid article a span { color:#6de8e2; margin-left:7px; }
  .ambient { position:absolute; border-radius:50%; filter:blur(95px); pointer-events:none; } .ambient-one { width:520px; height:520px; background:#1268d1; opacity:.32; top:-70px; right:3%; } .ambient-two { width:370px; height:370px; background:#0bbdd0; opacity:.14; top:780px; left:-180px; }
  .hero { min-height:670px; display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:22px; padding-top:70px; padding-bottom:74px; position:relative; } .hero-copy { position:relative; z-index:2; } .eyebrow { color:#72d9ee; text-transform:uppercase; letter-spacing:.2em; font-size:.66rem; font-weight:700; margin:0 0 25px; } .pulse { display:inline-block; width:7px; height:7px; margin-right:10px; border-radius:50%; background:#72f1e2; box-shadow:0 0 15px #72f1e2; } h1 { font-size:clamp(3.8rem,7.3vw,7.3rem); line-height:.88; letter-spacing:-.09em; margin:0 0 30px; max-width:720px; } h1 span,h2 span { color:#55c7ff; } .lead { color:#b6c9dd; font-size:1.13rem; line-height:1.6; max-width:510px; margin:0 0 34px; } .actions { display:flex; align-items:center; gap:26px; flex-wrap:wrap; } .button { display:inline-flex; align-items:center; background:#f4fbff; color:#071a35; padding:16px 21px; text-decoration:none; border-radius:7px; font-size:.78rem; font-weight:700; box-shadow:0 0 38px rgba(78,205,255,.22); } .text-link { color:#c0d3e7; text-decoration:none; font-size:.79rem; } .hero-note { display:flex; align-items:center; gap:12px; color:#7f9ab7; font-size:.72rem; margin-top:54px; letter-spacing:.02em; } .note-line { width:32px; height:1px; background:#47c9e7; box-shadow:0 0 10px #47c9e7; }
  .hero-visual { min-height:525px; position:relative; display:grid; place-items:center; isolation:isolate; } .visual-glow { position:absolute; width:390px; height:390px; border-radius:50%; background:radial-gradient(circle,rgba(34,178,255,.3),transparent 66%); filter:blur(10px); } .network-art { width:100%; max-width:620px; overflow:visible; position:relative; z-index:1; } .planet { stroke:#55dfff; stroke-opacity:.5; stroke-width:1; filter:drop-shadow(0 0 28px rgba(49,191,255,.6)); } .orbit { fill:none; stroke:#5ad8ff; stroke-width:1.1; stroke-opacity:.52; transform-origin:360px 294px; } .orbit-one { animation:orbit-spin 18s linear infinite; } .orbit-two { animation:orbit-spin 24s linear -7s infinite reverse; } .orbit-three { animation:orbit-spin 30s linear -12s infinite; } .network-lines path { fill:none; stroke:#84eaff; stroke-opacity:.3; stroke-width:1; stroke-dasharray:5 10; animation:network-flow 8s linear infinite; } .network-lines path:nth-child(2n) { animation-duration:11s; animation-direction:reverse; } .data-trails path { stroke-width:2; stroke-dasharray:10 15; animation:trail-flow 6s linear infinite; } .data-trails path:nth-child(2) { animation-delay:-3s; animation-duration:8s; } .nodes circle { fill:#e7fdff; animation:node-pulse 3s ease-in-out infinite; } .nodes circle:nth-child(2n) { animation-delay:-1.2s; } .signal-node { fill:#7dffe5; animation:signal-pulse 2.5s ease-in-out infinite; } .visual-label { position:absolute; color:#a8c5df; font-size:.58rem; letter-spacing:.18em; z-index:2; } .label-top { top:56px; right:8%; } .label-bottom { bottom:62px; left:5%; } .visual-label span { color:#73f0df; } .label-dot { display:inline-block; width:6px; height:6px; border-radius:50%; background:#73f0df; box-shadow:0 0 12px #73f0df; margin-right:9px; }
  .hero-carousel { height:720px; position:relative; isolation:isolate; overflow:hidden; border-bottom:1px solid rgba(179,226,255,.2); touch-action:pan-y; }
  .hero-slide { position:absolute; inset:0; opacity:0; visibility:hidden; pointer-events:none; transform:translateX(35px) scale(.985); transition:opacity .8s ease,transform .8s ease,visibility 0s linear .8s; }
  .hero-slide.is-active { opacity:1; visibility:visible; pointer-events:auto; transform:none; transition:opacity .8s ease,transform .8s ease; z-index:2; }
  .slide-strategy .hero { min-height:100%; padding-top:30px; padding-bottom:120px; }
  .slide-global,.slide-impact { display:flex; align-items:center; overflow:hidden; }
  .slide-global-image { position:absolute; inset:0; background:url('/hero-network.png') center center / cover no-repeat; mask-image:linear-gradient(90deg,transparent,#000 17%,#000 72%,transparent),linear-gradient(180deg,transparent,#000 12%,#000 84%,transparent); mask-composite:intersect; transform:scale(1.08); transition:transform 8s ease-out; }
  .slide-global.is-active .slide-global-image { transform:scale(1); }
  .slide-global-shade { position:absolute; inset:0; background:linear-gradient(90deg,#061a35,rgba(6,26,53,.82) 27%,rgba(6,26,53,.25) 54%,transparent 76%),linear-gradient(0deg,rgba(6,26,53,.3),transparent 27%); }
  .slide-copy { width:min(610px,58%); position:relative; z-index:2; padding:0 0 80px 50px; }
  .slide-copy h2 { font-size:clamp(3.9rem,6.7vw,7rem); margin-bottom:28px; }
  .slide-copy h2 span { color:#6fdfff; }
  .slide-copy > p:not(.eyebrow) { max-width:480px; color:#d9e9f7; font-size:1.08rem; line-height:1.65; margin:0 0 32px; }
  .slide-impact .slide-copy { width:55%; }
  .slide-impact .slide-copy h2 { font-size:clamp(3.6rem,5.9vw,6rem); }
  .slide-side-note { position:absolute; z-index:2; right:32px; bottom:128px; color:#c9e9fa; letter-spacing:.2em; font-size:.6rem; }
  .slide-impact { background:radial-gradient(circle at 75% 45%,rgba(35,126,220,.34),transparent 48%); }
  .slide-impact::before { content:''; position:absolute; inset:0; opacity:.18; background-image:linear-gradient(rgba(159,225,255,.2) 1px,transparent 1px),linear-gradient(90deg,rgba(159,225,255,.2) 1px,transparent 1px); background-size:55px 55px; mask-image:linear-gradient(90deg,transparent 18%,black 38%,black 78%,transparent),linear-gradient(180deg,transparent,#000 16%,#000 78%,transparent); mask-composite:intersect; }
  .impact-visual { position:absolute; width:45%; height:560px; right:10px; top:25px; perspective:800px; }
  .impact-halo { position:absolute; width:410px; height:410px; top:72px; left:60px; border-radius:50%; border:1px solid rgba(112,227,255,.35); box-shadow:0 0 0 65px rgba(107,217,255,.035),0 0 85px rgba(91,195,255,.24),inset 0 0 75px rgba(28,176,255,.12); animation:halo-breathe 6s ease-in-out infinite; }
  .impact-connector { position:absolute; width:2px; height:430px; left:48%; top:75px; transform:rotate(-27deg); background:linear-gradient(transparent,#7eeaff,transparent); box-shadow:0 0 17px #64dfff; opacity:.7; }
  .impact-card { position:absolute; min-height:146px; padding:23px 25px; border:1px solid rgba(139,225,255,.48); border-radius:13px; background:linear-gradient(145deg,rgba(19,87,155,.76),rgba(10,37,81,.9)); box-shadow:0 24px 45px rgba(1,13,41,.5),inset 0 1px 0 rgba(233,250,255,.2); backdrop-filter:blur(14px); display:flex; flex-direction:column; justify-content:space-between; }
  .impact-card span { color:#7de4f4; font-size:.61rem; font-weight:700; letter-spacing:.18em; }
  .impact-card strong { color:#f5fbff; font-size:1.16rem; letter-spacing:-.03em; }
  .impact-card-one { top:10%; left:1%; width:66%; transform:rotate(-5deg); animation:float-one 6s ease-in-out infinite; }
  .impact-card-two { top:36%; right:1%; width:64%; transform:rotate(4deg); animation:float-two 7s ease-in-out infinite; }
  .impact-card-three { bottom:6%; left:10%; width:68%; transform:rotate(-3deg); animation:float-three 6.5s ease-in-out infinite; }
  .signal-bars { display:flex; align-items:end; gap:7px; height:38px; }
  .signal-bars i { display:block; width:15px; height:30%; border-radius:3px 3px 0 0; background:linear-gradient(#8af9f1,#43a5ef); box-shadow:0 0 10px rgba(96,230,251,.45); transform-origin:bottom; animation:bar-rise 2.4s ease-in-out infinite alternate; }
  .signal-bars i:nth-child(2) { height:70%; animation-delay:-.5s; }.signal-bars i:nth-child(3) { height:45%; animation-delay:-1.1s; }.signal-bars i:nth-child(4) { height:90%; animation-delay:-1.7s; }.signal-bars i:nth-child(5) { height:55%; animation-delay:-.8s; }.signal-bars i:nth-child(6) { height:76%; animation-delay:-1.4s; }.signal-bars i:nth-child(7) { height:40%; animation-delay:-.3s; }
  .impact-map { height:34px; display:flex; justify-content:space-between; align-items:center; position:relative; }
  .impact-map::before { content:''; position:absolute; left:0; right:0; top:50%; height:1px; background:#68dfff; box-shadow:0 0 12px #68dfff; }
  .impact-map i,.impact-line i { position:relative; display:block; width:10px; height:10px; border-radius:50%; background:#c3fffb; box-shadow:0 0 12px #73f0ed; }
  .impact-map i:nth-child(2n) { width:6px; height:6px; }
  .impact-line { height:36px; display:flex; justify-content:space-between; align-items:center; border-bottom:2px solid rgba(128,232,255,.55); transform:skewY(-5deg); }
  .carousel-controls { position:absolute; z-index:5; bottom:24px; left:0; right:0; display:flex; align-items:end; gap:32px; padding:0 22px; }
  .slide-tabs { display:flex; flex:1; gap:20px; }
  .slide-tab { position:relative; width:160px; padding:13px 0 0; border:0; border-top:1px solid rgba(205,240,255,.38); background:none; text-align:left; color:#b4c9dd; font-size:.77rem; cursor:pointer; }
