---
const services = [
  { number: '01', title: 'LegalTech & Innovation', text: 'Modernize legal operations with clear strategy, better systems and measurable adoption.' },
  { number: '02', title: 'Data & Intelligence', text: 'Turn fragmented information into decision-ready intelligence and operational advantage.' },
  { number: '03', title: 'AI Strategy & Automation', text: 'Identify the right AI opportunities and move from experimentation to impact.' },
];
const principles = [
  { number: '01', title: 'See the system', text: 'Map the moving parts, the friction and the signals that matter.' },
  { number: '02', title: 'Shape the move', text: 'Turn strategic intent into a practical sequence of decisions and builds.' },
  { number: '03', title: 'Make it stick', text: 'Create adoption through useful tools, clear ownership and measurable momentum.' },
];
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#071a35" />
    <title>GDA Consulting | Technology, Data & Innovation</title>
    <meta name="description" content="GDA Consulting connects strategy, technology and intelligence to help ambitious teams build what is next." />
  </head>
  <body>
    <div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
    <header>
      <a class="brand" href="/" aria-label="GDA Consulting home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 100 100" role="img">
            <defs>
              <linearGradient id="logo-gradient" x1="12" y1="84" x2="88" y2="14" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#2bbcff" /><stop offset=".55" stop-color="#5f9dff" /><stop offset="1" stop-color="#79f1df" /></linearGradient>
              <linearGradient id="logo-highlight" x1="18" y1="20" x2="84" y2="84" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#79f1df" /><stop offset="1" stop-color="#2bbcff" /></linearGradient>
            </defs>
            <path d="M82 21C69 11 48 9 31 17 12 26 8 48 18 66c11 20 37 27 58 17 12-6 19-16 21-29H61" fill="none" stroke="url(#logo-gradient)" stroke-width="13" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M82 21 58 36" fill="none" stroke="url(#logo-highlight)" stroke-width="13" stroke-linecap="round" />
            <path d="M77 77 52 61" fill="none" stroke="#e9fbff" stroke-opacity=".9" stroke-width="11" stroke-linecap="round" />
          </svg>
        </span><span>GDA<span class="muted"> Consulting</span></span>
      </a>
      <nav aria-label="Primary"><a class="nav-link" href="#services">Capabilities</a><a class="nav-link" href="#approach">Approach</a><a class="nav-link nav-cta" href="mailto:info@gdaconsulting.com.ar">Let’s talk <span>↗</span></a></nav>
    </header>
    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow"><span class="pulse"></span> Strategy · Systems · Intelligence</p>
          <h1>Turn complexity<br /><span>into momentum.</span></h1>
          <p class="lead">GDA Consulting helps ambitious teams connect business intent with technology that moves the work forward.</p>
          <div class="actions"><a class="button" href="mailto:info@gdaconsulting.com.ar">Start a conversation <span>↗</span></a><a class="text-link" href="#services">Explore capabilities <span>↓</span></a></div>
          <div class="hero-note"><span class="note-line"></span><span>A global perspective for teams navigating what’s next.</span></div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="visual-glow"></div>
          <svg class="network-art" viewBox="0 0 620 560" role="img">
            <defs>
              <radialGradient id="planet-fill" cx="35%" cy="30%"><stop offset="0" stop-color="#45d9ff" stop-opacity=".9" /><stop offset=".42" stop-color="#2479dc" stop-opacity=".72" /><stop offset="1" stop-color="#071b3b" stop-opacity=".1" /></radialGradient>
              <linearGradient id="arc-blue" x1="0" y1="1" x2="1" y2="0"><stop stop-color="#2bbcff" stop-opacity=".05" /><stop offset=".5" stop-color="#76efff" /><stop offset="1" stop-color="#8294ff" stop-opacity=".18" /></linearGradient>
              <filter id="blue-glow"><feGaussianBlur stdDeviation="7" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
              <clipPath id="planet-clip"><circle cx="360" cy="294" r="162" /></clipPath>
            </defs>
            <g class="art-orbits">
              <ellipse class="orbit orbit-one" cx="360" cy="294" rx="222" ry="108" />
              <ellipse class="orbit orbit-two" cx="360" cy="294" rx="190" ry="244" transform="rotate(54 360 294)" />
              <ellipse class="orbit orbit-three" cx="360" cy="294" rx="164" ry="250" transform="rotate(-58 360 294)" />
            </g>
            <circle class="planet" cx="360" cy="294" r="162" fill="url(#planet-fill)" />
            <g class="network-lines" clip-path="url(#planet-clip)">
              <path d="M160 246C244 181 342 181 468 232 536 259 566 311 592 364" />
              <path d="M142 322C245 285 360 277 548 317" />
              <path d="M205 404C296 352 401 350 540 394" />
              <path d="M270 126C300 211 312 310 278 470" />
              <path d="M380 112C347 225 371 346 432 468" />
              <path d="M468 145C411 231 447 339 510 421" />
            </g>
            <g class="data-trails" fill="none" stroke-linecap="round">
              <path d="M75 394C180 390 202 286 302 246S470 164 568 80" stroke="url(#arc-blue)" />
              <path d="M140 96C245 145 280 205 394 215S514 285 568 454" stroke="url(#arc-blue)" />
            </g>
            <g class="nodes" filter="url(#blue-glow)">
              <circle cx="212" cy="242" r="5" /><circle cx="277" cy="362" r="6" /><circle cx="365" cy="181" r="5" /><circle cx="460" cy="281" r="7" /><circle cx="424" cy="407" r="5" /><circle cx="508" cy="176" r="4" />
            </g>
            <circle class="signal-node" cx="568" cy="80" r="7" filter="url(#blue-glow)" />
          </svg>
          <div class="visual-label label-top"><span class="label-dot"></span>GLOBAL / SIGNAL</div>
          <div class="visual-label label-bottom">SYSTEMS THAT MOVE <span>↗</span></div>
        </div>
      </section>
      <section class="signal-row"><div><strong>01</strong><span>Strategic clarity</span></div><div><strong>02</strong><span>Technical depth</span></div><div><strong>03</strong><span>Global reach</span></div></section>
      <section class="services" id="services">
        <div class="section-heading"><div><p class="eyebrow">Capabilities</p><h2>Where strategy<br /><span>gets real.</span></h2></div><p class="section-intro">From legal operations to data and AI, we bring the right level of clarity, technology and momentum to the problem in front of you.</p></div>
        <div class="service-grid">{services.map((service) => <article><div class="service-top"><span>{service.number}</span><span class="arrow">↗</span></div><h3>{service.title}</h3><p>{service.text}</p><a href="mailto:info@gdaconsulting.com.ar">Explore the conversation <span>↗</span></a></article>)}</div>
      </section>
      <section class="approach" id="approach">
        <div class="section-heading approach-heading"><div><p class="eyebrow">The GDA approach</p><h2>Clarity is a<br /><span>competitive edge.</span></h2></div><p class="section-intro">Good transformation is not theatre. It is a sequence of smart decisions, useful systems and people who know what happens next.</p></div>
        <div class="principle-grid">{principles.map((principle) => <article><span class="principle-number">{principle.number}</span><h3>{principle.title}</h3><p>{principle.text}</p></article>)}</div>
      </section>
      <section class="contact-panel"><div><p class="eyebrow">Let’s build what’s next</p><h2>Ready when<br /><span>you are.</span></h2></div><div class="contact-details"><p>Tell us what feels complex. We’ll help you find the signal.</p><a class="contact-email" href="mailto:info@gdaconsulting.com.ar">info@gdaconsulting.com.ar <span>↗</span></a><a href="tel:+17864809312">+1 (786) 480-9312</a><a href="tel:+5492616681106">+54 9 261 668 1106</a></div></section>
    </main>
    <footer><span>© {new Date().getFullYear()} GDA Consulting</span><span>Global perspective · Built for what’s next</span></footer>
  </body>
</html>
<style>
  :global(*) { box-sizing:border-box; } :global(html) { scroll-behavior:smooth; } :global(body) { margin:0; background:#071a35; color:#f4f9ff; font-family:Arial, Helvetica, sans-serif; overflow-x:hidden; } :global(body)::before { content:''; position:fixed; inset:0; pointer-events:none; opacity:.14; background-image:linear-gradient(rgba(142,219,255,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(142,219,255,.12) 1px,transparent 1px); background-size:72px 72px; mask-image:linear-gradient(to bottom,black,transparent 75%); }
  header,main,footer { max-width:1240px; margin:auto; padding-left:32px; padding-right:32px; } header { display:flex; align-items:center; justify-content:space-between; gap:28px; padding-top:28px; padding-bottom:25px; position:relative; z-index:5; } .brand { display:flex; align-items:center; gap:11px; color:#f7fbff; text-decoration:none; font-weight:700; letter-spacing:-.03em; font-size:1.08rem; } .brand-mark { display:block; width:37px; height:37px; flex:0 0 37px; } .brand-mark svg { display:block; width:100%; height:100%; filter:drop-shadow(0 0 12px rgba(43,188,255,.36)); } .muted { color:#91aac8; font-weight:400; } nav { display:flex; align-items:center; gap:27px; } .nav-link { color:#b9cde3; text-decoration:none; font-size:.74rem; letter-spacing:.04em; } .nav-link:hover { color:#fff; } .nav-cta { color:#f7fbff; } .nav-link span,.button span,.text-link span,.contact-details span,.service-grid article a span { color:#6de8e2; margin-left:7px; }
  .ambient { position:absolute; border-radius:50%; filter:blur(95px); pointer-events:none; } .ambient-one { width:520px; height:520px; background:#1268d1; opacity:.32; top:-70px; right:3%; } .ambient-two { width:370px; height:370px; background:#0bbdd0; opacity:.14; top:780px; left:-180px; }
  .hero { min-height:670px; display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:22px; padding-top:70px; padding-bottom:74px; position:relative; } .hero-copy { position:relative; z-index:2; } .eyebrow { color:#72d9ee; text-transform:uppercase; letter-spacing:.2em; font-size:.66rem; font-weight:700; margin:0 0 25px; } .pulse { display:inline-block; width:7px; height:7px; margin-right:10px; border-radius:50%; background:#72f1e2; box-shadow:0 0 15px #72f1e2; } h1 { font-size:clamp(3.8rem,7.3vw,7.3rem); line-height:.88; letter-spacing:-.09em; margin:0 0 30px; max-width:720px; } h1 span,h2 span { color:#55c7ff; } .lead { color:#b6c9dd; font-size:1.13rem; line-height:1.6; max-width:510px; margin:0 0 34px; } .actions { display:flex; align-items:center; gap:26px; flex-wrap:wrap; } .button { display:inline-flex; align-items:center; background:#f4fbff; color:#071a35; padding:16px 21px; text-decoration:none; border-radius:7px; font-size:.78rem; font-weight:700; box-shadow:0 0 38px rgba(78,205,255,.22); } .text-link { color:#c0d3e7; text-decoration:none; font-size:.79rem; } .hero-note { display:flex; align-items:center; gap:12px; color:#7f9ab7; font-size:.72rem; margin-top:54px; letter-spacing:.02em; } .note-line { width:32px; height:1px; background:#47c9e7; box-shadow:0 0 10px #47c9e7; }
  .hero-visual { min-height:525px; position:relative; display:grid; place-items:center; isolation:isolate; } .visual-glow { position:absolute; width:390px; height:390px; border-radius:50%; background:radial-gradient(circle,rgba(34,178,255,.3),transparent 66%); filter:blur(10px); } .network-art { width:100%; max-width:620px; overflow:visible; position:relative; z-index:1; } .planet { stroke:#55dfff; stroke-opacity:.5; stroke-width:1; filter:drop-shadow(0 0 28px rgba(49,191,255,.6)); } .orbit { fill:none; stroke:#5ad8ff; stroke-width:1.1; stroke-opacity:.52; transform-origin:360px 294px; } .orbit-one { animation:orbit-spin 18s linear infinite; } .orbit-two { animation:orbit-spin 24s linear -7s infinite reverse; } .orbit-three { animation:orbit-spin 30s linear -12s infinite; } .network-lines path { fill:none; stroke:#84eaff; stroke-opacity:.3; stroke-width:1; stroke-dasharray:5 10; animation:network-flow 8s linear infinite; } .network-lines path:nth-child(2n) { animation-duration:11s; animation-direction:reverse; } .data-trails path { stroke-width:2; stroke-dasharray:10 15; animation:trail-flow 6s linear infinite; } .data-trails path:nth-child(2) { animation-delay:-3s; animation-duration:8s; } .nodes circle { fill:#e7fdff; animation:node-pulse 3s ease-in-out infinite; } .nodes circle:nth-child(2n) { animation-delay:-1.2s; } .signal-node { fill:#7dffe5; animation:signal-pulse 2.5s ease-in-out infinite; } .visual-label { position:absolute; color:#a8c5df; font-size:.58rem; letter-spacing:.18em; z-index:2; } .label-top { top:56px; right:8%; } .label-bottom { bottom:62px; left:5%; } .visual-label span { color:#73f0df; } .label-dot { display:inline-block; width:6px; height:6px; border-radius:50%; background:#73f0df; box-shadow:0 0 12px #73f0df; margin-right:9px; }
  .signal-row { border-top:1px solid rgba(179,226,255,.2); border-bottom:1px solid rgba(179,226,255,.2); display:grid; grid-template-columns:repeat(3,1fr); padding:22px 0; } .signal-row div { display:flex; gap:18px; align-items:center; padding-left:20px; border-left:1px solid rgba(179,226,255,.2); } .signal-row div:first-child { border-left:0; padding-left:0; } .signal-row strong { color:#62d6fa; font-size:.72rem; } .signal-row span { color:#d5e4f2; font-size:.8rem; }
  .services,.approach { padding:130px 0 120px; } .approach { padding-top:0; } .section-heading { display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:end; margin-bottom:58px; } .approach-heading { margin-bottom:44px; } h2 { font-size:clamp(3rem,5.9vw,5.8rem); line-height:.9; letter-spacing:-.08em; margin:0; } .section-intro { color:#9fb6ce; line-height:1.65; max-width:420px; margin:0 0 5px; } .service-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; } .service-grid article { min-height:310px; padding:24px; border:1px solid rgba(179,226,255,.18); border-radius:14px; background:linear-gradient(145deg,rgba(75,180,255,.12),rgba(255,255,255,.025)); transition:transform .3s,border-color .3s,background .3s; } .service-grid article:hover { transform:translateY(-8px); border-color:rgba(104,233,238,.75); background:linear-gradient(145deg,rgba(75,180,255,.2),rgba(255,255,255,.04)); } .service-top { display:flex; justify-content:space-between; color:#6ddaf9; font-size:.75rem; } h3 { font-size:1.6rem; line-height:1.05; letter-spacing:-.05em; margin:72px 0 16px; max-width:250px; } .service-grid p,.principle-grid p { color:#a1b8cf; line-height:1.6; font-size:.88rem; max-width:285px; } .service-grid article a { display:inline-block; color:#dcecf8; text-decoration:none; font-size:.72rem; letter-spacing:.04em; margin-top:18px; }
  .principle-grid { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid rgba(179,226,255,.18); border-bottom:1px solid rgba(179,226,255,.18); } .principle-grid article { min-height:230px; padding:25px 25px 28px 0; border-right:1px solid rgba(179,226,255,.18); } .principle-grid article:not(:first-child) { padding-left:25px; } .principle-grid article:last-child { border-right:0; } .principle-number { color:#69dff5; font-size:.7rem; } .principle-grid h3 { margin:55px 0 15px; font-size:1.45rem; }
  .contact-panel { border:1px solid rgba(91,218,238,.42); border-radius:16px; padding:56px; display:grid; grid-template-columns:1fr 1fr; gap:30px; background:radial-gradient(circle at 82% 15%,rgba(26,153,255,.2),transparent 48%),linear-gradient(145deg,rgba(77,170,255,.1),rgba(255,255,255,.025)); } .contact-details { display:flex; flex-direction:column; justify-content:center; gap:13px; } .contact-details p { color:#b3c9dd; line-height:1.5; margin:0 0 9px; max-width:330px; } .contact-details a { color:#dcecf8; text-decoration:none; font-size:.94rem; } .contact-email { color:#7ce7f0 !important; } footer { display:flex; justify-content:space-between; color:#7894b2; font-size:.7rem; padding-top:25px; padding-bottom:30px; }
  @keyframes orbit-spin { from { transform:rotate(0deg); } to { transform:rotate(360deg); } } @keyframes network-flow { from { stroke-dashoffset:0; } to { stroke-dashoffset:-90; } } @keyframes trail-flow { from { stroke-dashoffset:0; } to { stroke-dashoffset:-150; } } @keyframes node-pulse { 0%,100% { opacity:.55; transform:scale(.85); transform-origin:center; } 50% { opacity:1; transform:scale(1.45); transform-origin:center; } } @keyframes signal-pulse { 0%,100% { opacity:.5; transform:scale(.8); transform-origin:center; } 50% { opacity:1; transform:scale(1.6); transform-origin:center; } }
  @media (prefers-reduced-motion:reduce) { .orbit,.network-lines path,.data-trails path,.nodes circle,.signal-node { animation:none; } }
  @media (max-width:800px) { header,main,footer { padding-left:20px; padding-right:20px; } nav { gap:14px; } nav .nav-link:not(.nav-cta) { display:none; } .hero { grid-template-columns:1fr; padding-top:54px; } .hero-visual { min-height:390px; margin-top:-5px; } .network-art { width:112%; } .label-top { top:26px; right:4%; } .label-bottom { bottom:32px; left:2%; } .signal-row { grid-template-columns:1fr; gap:15px; } .signal-row div { border-left:0; padding-left:0; } .services { padding:95px 0 100px; } .section-heading,.contact-panel { grid-template-columns:1fr; } .service-grid,.principle-grid { grid-template-columns:1fr; } .service-grid article { min-height:250px; } .principle-grid article,.principle-grid article:not(:first-child) { border-right:0; border-bottom:1px solid rgba(179,226,255,.18); padding:24px 0; min-height:0; } .principle-grid article:last-child { border-bottom:0; } .principle-grid h3 { margin-top:28px; } .contact-panel { padding:34px 24px; } footer { flex-direction:column; gap:10px; } }
</style>
